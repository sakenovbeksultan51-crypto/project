{
  "name": "tableflow-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/ensure-ollama.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop": "node scripts/start-local.mjs",
    "dev": "vinext dev",
    "build": "vinext build",
    "build:vercel": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts tests/*.test.tsx",
    "check": "tsc --noEmit",
    "telegram:setup": "node --import tsx scripts/setup-telegram.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@neondatabase/serverless": "^1.2.1",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@upstash/qstash": "^2.12.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "nitro": "^3.0.261103-rc",
    "onnxruntime-web": "^1.20.1",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
